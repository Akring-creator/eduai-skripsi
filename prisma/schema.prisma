datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

generator dbml {
  provider = "prisma-dbml-generator"
}

model Course {
  id          String  @id @default(uuid())
  userId      String
  title       String  @db.Text
  description String? @db.Text
  imageUrl    String? @db.Text
  price       Float?
  isPublished Boolean @default(false)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  attachments Attachment[]

  createdAt DateTime   @default(now())
  updateAt  DateTime   @updatedAt
  chapters  Chapter[]
  purchases Purchase[]

  @@index([categoryId])
  @@fulltext([title])
}

model Chapter {
  id          String  @id @default(uuid())
  title       String
  description String? @db.MediumText
  videoUrl    String? @db.Text
  position    Int
  isPublished Boolean @default(false)
  isFree      Boolean @default(false)

  muxData  MuxData?
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  userProgress UserProgress[]

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@index([courseId])
}

model MuxData {
  id         String  @id @default(uuid())
  assetId    String
  playbackId String?
  chapterId  String  @unique
  chapter    Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

model UserProgress {
  id     String @id @default(uuid())
  userId String

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updateAt    DateTime @updatedAt

  @@unique([userId, chapterId])
  @@index([chapterId])
}

model Category {
  id      String   @id @default(uuid())
  name    String   @unique
  courses Course[]
  quizzes Quiz[]
}

model Attachment {
  id   String @id @default(uuid())
  name String
  url  String @db.Text

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@index([courseId])
}

enum QuestionType {
  multipleChoice
  shortAnswer
  longAnswer
}

model Question {
  id          String   @id @default(uuid())
  question    String   @db.MediumText
  questionType QuestionType 
  imageUrl    String?  @db.Text
  answer      String   @db.Text
  isPublished Boolean  @default(true)
  explanation String   @db.MediumText
  options     Option[]
  quizId      String
  
  position    Int
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@index([quizId])
}

model Option {
  id       String  @id @default(uuid())
  option   String  @db.Text
  imageUrl String? @db.Text
  position Int     @default(0)
  isKeyAnswer Boolean @default(false)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model Quiz {
  id          String  @id @default(uuid())
  userId      String
  title       String  @db.Text
  description String? @db.Text
  imageUrl    String? @db.Text
  price       Float?
  isPublished Boolean @default(false)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  learningActivitiesId String?
  learningActivities  LearningActivities?  @relation(fields: [learningActivitiesId], references: [id])

  questions   Question[]
  attachments QuizAttachment[]

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@index([categoryId])
  @@fulltext([title])
}

model QuizAttachment {
  id   String @id @default(uuid())
  name String
  url  String @db.Text

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@index([quizId])
}

model Purchase {
  id     String @id @default(uuid())
  userId String

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
}

model StripeCustomer {
  id               String @id @default(uuid())
  userId           String @unique
  stripeCustomerId String @unique

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

// Part schema for Modul Ajar

model studentTarget {

id String @id @default(uuid())
target String @db.Text

learningModules LearningModule[]
}
model learningModa {

id String @id @default(uuid())
moda String @db.Text

learningModules LearningModule[]
}

model PancasilaStudentsProfile {

id String @id @default(uuid())
name String @db.Text

learningModuleId String
learningModule LearningModule @relation(fields: [learningModuleId], references: [id])

@@index([learningModuleId])
}

model Subject {
  id String @id @default(uuid())
  name String @db.Text

  learningModule LearningModule[]

}

model Element{
  id  String @id @default(uuid())
  name String @db.Text
  expectedOutcome String @db.Text
  learningOutcomeId String
  learningOutcome LearningOutcome  @relation(fields: [learningOutcomeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
  @@index([learningOutcomeId])
}

model Phase{
  id String @id @default(uuid())
  name String @db.Text
  minClass Int
  maxClass Int
  educationLevels String?

  learningOutcome LearningOutcome[]
  learningModule LearningModule[]
}

model LearningOutcome {
  id String @id @default(uuid())
  subject String @db.Text
  generalOutcome String @db.Text
  phaseId String?
  phase  Phase? @relation(fields: [phaseId], references: [id])
  element Element[]
  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@index([phaseId])
}

model LearningObjective {
  id String @id @default(uuid())
  content String @db.Text
  learningModuleId String
  learningModule LearningModule @relation(fields: [learningModuleId], references: [id], onDelete: Cascade)

  @@index([learningModuleId])

}

model MeaningfulComprehension{
  id String @id @default(uuid())
  content String @db.Text
  learningModuleId String
  learningModule LearningModule @relation(fields: [learningModuleId], references: [id], onDelete: Cascade)

  @@index([learningModuleId])

}

model LearningObjectiveFlows {
  id String @id @default(uuid())
  content String @db.Text
  Position Int

  learningModuleId String
  learningModule LearningModule @relation(fields: [learningModuleId], references: [id], onDelete: Cascade)

  @@index([learningModuleId])

}
model TriggerQuestion {
  id String @id @default(uuid())
  content String @db.Text
  position Int

  learningModuleId String
  learningModule LearningModule @relation(fields: [learningModuleId], references: [id], onDelete: Cascade)

  @@index([learningModuleId])

}
model LearningFlow{
  id String @id @default(uuid())
  meeting Int
  learningActivitesId String
  learningActivities LearningActivities[]


  learningModuleId String
  learningModule LearningModule @relation(fields: [learningModuleId], references: [id], onDelete: Cascade)

  @@index([learningModuleId])

}

model LearningActivities{
  id String @id @default(uuid())
  learningPhaseId String
  learningPhase LearningPhase[]

  quiz Quiz[]
  learningFlowId String
  learningFlow LearningFlow @relation(fields: [learningFlowId], references: [id], onDelete: Cascade)

  @@index([learningFlowId])


}

model LearningPhase{
  id String @id @default(uuid())
  content String @db.Text
  position Int

  learningActivitiesId String
  learningActivities LearningActivities @relation(fields: [learningActivitiesId], references: [id], onDelete: Cascade)

  @@index([learningActivitiesId])

  

}

model LearningModule {
  id String @id @default(uuid())
  userId String
  title String @db.Text
  numOfMeeting Int?
  LearningHours String?
  
  phaseId String?
  phase Phase? @relation(fields: [phaseId], references: [id])
  class Int?
  subjectId String?
  subject Subject? @relation(fields: [subjectId], references: [id])
  modaId String?
  moda learningModa? @relation(fields: [modaId], references: [id])
  model String? @db.Text
  studentTargetId String?
  studentTarget studentTarget? @relation(fields: [studentTargetId], references: [id])

  tripleP PancasilaStudentsProfile[]
  initialMaterial String? @db.MediumText
  teacherReflection String? @db.Text
  learningGoals LearningObjective[]
  learningObjectiveFlows LearningObjectiveFlows[]
  method String? @db.Text
  meaningfulComprehension MeaningfulComprehension[]
  triggerQuestion TriggerQuestion[]
  LearningFlow LearningFlow[]
  @@index([phaseId])
}